filter_evens([], []).

filter_evens([Head|Tail], [Head|Evens]) :-
    /* 'mod 2' checks the remainder */
    0 is Head mod 2,             
    filter_evens(Tail, Evens).

filter_evens([Head|Tail], Evens) :-
    /* abs() handles negative numbers */
    1 is abs(Head mod 2),        
    filter_evens(Tail, Evens).
    
check_range(N) :- 
    N >= -1000, 
    N =< 1000.

process_line(Numbers) :-
    /* check constraints */
    maplist(check_range, Numbers),
    
    /* gets only the even numbers */
    filter_evens(Numbers, Evens),
    
    /* reverse list */
    reverse(Evens, ReversedEvens),
    
    atomic_list_concat(ReversedEvens, ' ', Output),
    writeln(Output).

solve :-
    read_line_to_string(user_input, Line),
    split_string(Line, " ", "", [NStr|StringList]),
    
    /* convert N and check constraint */
    number_string(N, NStr),
    N >= 2, 
    N =< 100,
    
    /* convert the rest of the numbers */
    maplist(number_string, Numbers, StringList),
    
    process_line(Numbers).

    
:- initialization((solve, halt)).