import Data.List (sort)

main :: IO ()
main = do
    
    line <- getLine
    let parts = words line

    let nums = map read parts :: [Integer]

    if length nums == 3 && all (\n -> n >= -100 && n <= 100) nums
        then do
            {- sorts number -}
            let sortedNums = sort nums
            
            {- prints sorted -}
            putStrLn (unwords (map show sortedNums))
            
            {- prints og -}
            putStrLn (unwords (map show nums))
        else return ()
