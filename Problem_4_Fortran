PROGRAM simpleSort
    IMPLICIT NONE 

    INTEGER :: a, b, c, x, y, z, temp
    READ *, a, b, c
    IF (a >= -100 .AND. a <= 100 .AND. b >= -100 .AND. b <= 100 .AND. c >= -100 .AND. c <= 100) THEN
        x = a 
        y = b 
        z = c
        IF (x > y) THEN
            temp = x 
            x = y 
            y = temp 
        END IF
        
        IF (y > z) THEN
            temp = y 
            y = z 
            z = temp 
        END IF
        
        IF (x > y) THEN
            temp = x 
            x = y 
            y = temp 
        END IF
        PRINT '(I0, 1X, I0, 1X, I0)', x, y, z ! 1x is for space !
        PRINT '(I0, 1X, I0, 1X, I0)', a, b, c
    ELSE
        STOP
    END IF
END PROGRAM simpleSort