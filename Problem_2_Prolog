count_uppercase([], 0).

count_uppercase([Head|Tail], Count) :-
    char_type(Head, upper),           % checks if H is A-Z
    count_uppercase(Tail, RestCount), % go look at the rest of the list
    Count is RestCount + 1.        % add 1 to whatever we found in the rest
    
count_uppercase([Head|Tail], Count) :-
    \+ char_type(Head, upper),        %  \+ means "NOT"
    count_uppercase(Tail, Count).     % count stays exactly the same as the Tail's count
    
process_test_cases(0) :- !.

process_test_cases(N) :-
    read_line_to_string(user_input, N_char_string),
    split_string(N_char_string, " ", "", [T_string, Char_string]), % split at the space
    
    % convert t and check constraint
    number_string(T, T_string),
    between(1, 100, T),
    
    % convert to list
    string_chars(Char_string, List),
    count_uppercase(List, Result),
    
    writeln(Result), 
    
    % loop back
    NextN is N - 1,
    process_test_cases(NextN).

solve :-
    read_line_to_string(user_input, N_string), 
    number_string(N, N_string),
    between(1, 100, N),
    process_test_cases(N).

:- initialization((solve, halt)).