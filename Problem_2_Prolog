count_uppercase([], 0).

count_uppercase([Head|Tail], Count) :-
    % checks if H is A-Z
    char_type(Head, upper),   

    % go look at the rest of the list
    count_uppercase(Tail, RestCount), 
    
    % add 1 to whatever we found in the rest
    Count is RestCount + 1.        
    
count_uppercase([Head|Tail], Count) :-
    
    %  \+ means "NOT"
    \+ char_type(Head, upper),   
    
    % count stays exactly the same as the Tail's count
    count_uppercase(Tail, Count).     
    
process_test_cases(0) :- !.

process_test_cases(N) :-
    read_line_to_string(user_input, N_char_string),
    
    %split the string by spaces
    split_string(N_char_string, " ", "", [T_string, Char_string]), 
    
    % convert t and check constraint
    number_string(T, T_string),
    between(1, 100, T),
    
    % convert to list
    string_chars(Char_string, List),
    count_uppercase(List, Result),
    
    writeln(Result), 
    
    % loop back
    NextN is N - 1,
    process_test_cases(NextN).

solve :-
    read_line_to_string(user_input, N_string), 
    
    % convert N and check constraint
    number_string(N, N_string),
    between(1, 100, N),
    
    process_test_cases(N).

:- initialization((solve, halt)).